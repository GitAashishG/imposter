{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./index.ts",
    "./model.ts",
    "./security.ts",
    "../src/game.ts",
    "../src/data.ts",
    "../src/party/protocol.ts"
  ],
  "exclude": ["./*.test.ts"]
}
